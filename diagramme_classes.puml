@startuml BudgetFlow_DiagrammeClasses

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam classHeaderBackgroundColor #0E2A47
skinparam classHeaderFontColor #FFFFFF
skinparam classBorderColor #B8864A
skinparam classBackgroundColor #FAFAF8
skinparam arrowColor #0E2A47
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

' ══════════════════════════════════════════════════════
'  ÉNUMÉRATIONS
' ══════════════════════════════════════════════════════

enum Role {
  ADMINISTRATEUR
  GESTIONNAIRE
  COMPTABLE
}

enum StatutBudget {
  BROUILLON
  SOUMIS
  APPROUVE
  REJETE
  CLOTURE
  ARCHIVE
}

enum TechniqueEstimation {
  ANALOGIE
  TROIS_POINTS
  ASCENDANTE
}

enum NiveauAlerte {
  NORMAL
  ORANGE
  ROUGE
  CRITIQUE
}

enum StatutDepense {
  SAISIE
  VALIDEE
  REJETEE
}

enum SectionLigne {
  REVENU
  DEPENSE
}

enum ActionAudit {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SUBMIT
  VIEW
  EXPORT
}

' ══════════════════════════════════════════════════════
'  MODULE ACCOUNTS
' ══════════════════════════════════════════════════════

class Departement {
  + id : UUID
  + code : String
  + nom : String
  + description : String
  + actif : Boolean
}

class Utilisateur {
  + id : UUID
  + matricule : String
  + email : String
  + nom : String
  + prenom : String
  + role : Role
  + actif : Boolean
  + bloque : Boolean
  + tentatives_connexion : Integer
  + date_creation : DateTime
  + derniere_connexion : DateTime
  --
  + se_connecter()
  + incrementer_tentatives()
  + debloquer()
}

' ══════════════════════════════════════════════════════
'  MODULE BUDGET — EXERCICE & ALLOCATION
' ══════════════════════════════════════════════════════

class BudgetAnnuel {
  + id : UUID
  + annee : Integer
  + annee_fin : Integer
  + montant_global : Decimal
  + description : String
  + est_cloture : Boolean
  + date_cloture : DateTime
  + date_creation : DateTime
  --
  + cloturer()
  + montant_disponible_global : Decimal
}

class AllocationDepartementale {
  + id : UUID
  + montant_alloue : Decimal
  + montant_consomme : Decimal
  + montant_disponible : Decimal
  + date_creation : DateTime
  --
  + recalculer_consommation()
  + verifier_disponibilite() : Boolean
}

' Classe d'association entre BudgetAnnuel et Departement
BudgetAnnuel "1" -- "0..*" Departement
(BudgetAnnuel, Departement) .. AllocationDepartementale

' ══════════════════════════════════════════════════════
'  MODULE BUDGET — BUDGET OPÉRATIONNEL
' ══════════════════════════════════════════════════════

class Budget {
  + id : UUID
  + code : String
  + nom : String
  + technique_estimation : TechniqueEstimation
  + statut : StatutBudget
  + montant_global : Decimal
  + montant_consomme : Decimal
  + montant_disponible : Decimal
  + motif_rejet : String
  + date_debut : Date
  + date_fin : Date
  + date_creation : DateTime
  + date_soumission : DateTime
  + date_cloture : DateTime
  --
  + soumettre_budget()
  + approuver_budget(comptable)
  + rejeter_budget(comptable, motif)
  + cloturer_budget()
  + archiver_budget()
  + calculer_taux_consommation() : Float
  + niveau_alerte : NiveauAlerte
}

class CategoriePrincipale {
  + id : UUID
  + code : String
  + libelle : String
  + ordre : Integer
  --
  + total : Decimal
}

class SousCategorie {
  + id : UUID
  + code : String
  + libelle : String
  + ordre : Integer
  --
  + total : Decimal
}

class LigneBudgetaire {
  + id : UUID
  + code : String
  + libelle : String
  + unite : String
  + section : SectionLigne
  + quantite : Decimal
  + prix_unitaire : Decimal
  + cout_optimiste : Decimal
  + cout_probable : Decimal
  + cout_pessimiste : Decimal
  + montant_alloue : Decimal
  + montant_consomme : Decimal
  + montant_disponible : Decimal
  + date_creation : DateTime
  --
  + effectuer_virement(dest, montant)
  + enregistrer_consommation(montant)
  + annuler_consommation(montant)
}

' ══════════════════════════════════════════════════════
'  MODULE BUDGET — DÉPENSES
' ══════════════════════════════════════════════════════

class Depense {
  + id : UUID
  + statut : StatutDepense
  + fournisseur : String
  + note : String
  + motif_rejet : String
  + montant_total : Decimal
  + date : DateTime
  --
  + valider(validateur)
  + rejeter(validateur, motif)
  + recalculer_total()
}

class ConsommationLigne {
  + id : UUID
  + reference : String
  + montant : Decimal
  + note : String
  + fournisseur : String
  + statut : StatutDepense
  + motif_rejet : String
  + date : DateTime
}

' Classe d'association entre Depense et LigneBudgetaire
Depense "1" -- "1..*" LigneBudgetaire
(Depense, LigneBudgetaire) .. ConsommationLigne

class PieceJustificative {
  + id : UUID
  + nom_original : String
  + taille : Integer
  + type_mime : String
  + description : String
  + md5_hash : String
  + uploaded_at : DateTime
  --
  + taille_lisible : String
}

' ══════════════════════════════════════════════════════
'  MODULE AUDIT & NOTIFICATION
' ══════════════════════════════════════════════════════

class LogAudit {
  + id : UUID
  + table : String
  + enregistrement_id : String
  + action : ActionAudit
  + valeur_avant : String
  + valeur_apres : String
  + date_action : DateTime
  --
  + {static} enregistrer(...)
  + {static} consulter(filtres) : List
}

class Notification {
  + id : UUID
  + type_notif : String
  + message : String
  + lien : String
  + lu : Boolean
  + date : DateTime
}

' ══════════════════════════════════════════════════════
'  RELATIONS — ACCOUNTS
' ══════════════════════════════════════════════════════

Utilisateur "0..*" --> "0..1" Departement : appartient à

' ══════════════════════════════════════════════════════
'  RELATIONS — BUDGET OPÉRATIONNEL
' ══════════════════════════════════════════════════════

Budget "0..*" --> "1"    BudgetAnnuel          : exercice
Budget "0..*" --> "0..1" AllocationDepartementale : allocation
Budget "0..*" --> "0..1" Departement           : département
Budget "0..*" --> "1"    Utilisateur           : gestionnaire
Budget "0..*" --> "0..1" Utilisateur           : comptable

CategoriePrincipale "0..*" --> "1" Budget         : structure
SousCategorie       "0..*" --> "1" CategoriePrincipale : structure

LigneBudgetaire "0..*" --> "1"    Budget        : appartient à
LigneBudgetaire "0..*" --> "0..1" SousCategorie : classée dans
LigneBudgetaire "0..*" --> "0..1" LigneBudgetaire : parent

' ══════════════════════════════════════════════════════
'  RELATIONS — DÉPENSES
' ══════════════════════════════════════════════════════

Depense "0..*" --> "1"    Budget      : concerne
Depense "0..*" --> "0..1" Utilisateur : enregistrée par
Depense "0..*" --> "0..1" Utilisateur : validée par

ConsommationLigne "0..*" --> "0..1" Utilisateur : enregistrée par
ConsommationLigne "0..*" --> "0..1" Utilisateur : validée par

PieceJustificative "0..*" --> "1"    Depense     : justifie
PieceJustificative "0..*" --> "1"    Utilisateur : uploadée par

' ══════════════════════════════════════════════════════
'  RELATIONS — AUDIT & NOTIFICATION
' ══════════════════════════════════════════════════════

LogAudit     "0..*" --> "0..1" Utilisateur : effectuée par
Notification "0..*" --> "1"    Utilisateur : destinataire

' ══════════════════════════════════════════════════════
'  RELATIONS ÉNUMÉRATIONS
' ══════════════════════════════════════════════════════

Utilisateur     ..> Role
Budget          ..> StatutBudget
Budget          ..> TechniqueEstimation
Budget          ..> NiveauAlerte
LigneBudgetaire ..> SectionLigne
Depense         ..> StatutDepense
ConsommationLigne ..> StatutDepense
LogAudit        ..> ActionAudit

@enduml
