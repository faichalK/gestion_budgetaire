# ─────────────────────────────────────────────────────────────────────────────
# Atlas Finance — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# NE JAMAIS committer .env dans git !
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# Générer avec : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-generate-a-real-50-char-secret-key
DEBUG=False

# ── Base de données (Railway fournit DATABASE_URL automatiquement) ─────────────
# Sur Railway : ajouter le plugin PostgreSQL, DATABASE_URL sera injecté
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Variables individuelles (utilisées si DATABASE_URL est absent)
DB_NAME=atlas_finance
DB_USER=postgres
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432

# ── Superuser créé automatiquement au premier démarrage ───────────────────────
DJANGO_SUPERUSER_EMAIL=admin@atlasfinance.org
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password
DJANGO_SUPERUSER_NOM=Admin
DJANGO_SUPERUSER_PRENOM=Super
DJANGO_SUPERUSER_MATRICULE=ADM001

# ── Domaine Railway (injecté automatiquement par Railway) ─────────────────────
# Décommenter si vous avez un domaine personnalisé
# RAILWAY_PUBLIC_DOMAIN=mon-app.up.railway.app

# ── CORS (origines autorisées en plus de Railway) ─────────────────────────────
# CORS_ALLOWED_ORIGINS=https://mon-frontend.com

# ── CSRF (origins de confiance en plus de *.railway.app) ──────────────────────
# CSRF_TRUSTED_ORIGINS=https://mon-frontend.com

# ── Intelligence Artificielle — Claude (Anthropic) ────────────────────────────
# Obtenir sur : https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-votre-cle-ici
# Mettre True pour désactiver les appels Claude (dev sans clé API)
SKIP_CLAUDE_API=True

# ── Email / SMTP ───────────────────────────────────────────────────────────────
# Laisser vide → les emails s'affichent dans les logs (mode console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Atlas Finance <noreply@atlasfinance.org>
